table Cust_Retention_Measure
	lineageTag: 1e5aeb4f-42da-4c61-a6e2-c03dea8ca552

	measure 'Customers Last Year' =
			
			VAR CurrentYear = MAX('Sales'[years])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Sales'[customer_id]),
			    'Sales'[years] = CurrentYear - 1
			
			)
		formatString: 0
		lineageTag: 78ff1e9f-ea5e-4419-9d82-a67b69387362

	measure 'Retained Customers YoY' = ```
			
			VAR CurrentYear = MAX('Sales'[years])
			VAR CurrentYearCustomers = 
			    CALCULATETABLE(
			        VALUES('Sales'[customer_id]),
			        'Sales'[years] = CurrentYear
			    )
			VAR LastYearCustomers = 
			    CALCULATETABLE(
			        VALUES('Sales'[customer_id]),
			        'Sales'[years] = CurrentYear - 1
			    )
			RETURN 
			    COUNTROWS(
			        INTERSECT(CurrentYearCustomers, LastYearCustomers)
			    )
			```
		formatString: 0
		lineageTag: 0835a316-69fe-4d33-96d1-af5a25a97a17

	measure 'YoY Retention Rate %' =
			
			DIVIDE(
			    [Retained Customers YoY],
			    [Customers Last Year],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: faf24cbc-7032-4df9-93c5-960267f967d3

	partition Cust_Retention_Measure = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	changedProperty = Name

	annotation PBI_ResultType = Table

